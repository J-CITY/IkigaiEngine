    {
      "name": "windows",
      "inherits": "engine-base",
      "displayName": "windows",
      "generator": "Visual Studio 17 2022",
      "vendor": {
        "ikigai.dev/launcher/1.0": {
          "platform": "win"
        }
      },
      "cacheVariables": {
        "IKIGAI_PLATFORM": "windows",
        "ENGINE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": "x64",
      "toolset": "host=x64",
      "binaryDir": "${sourceDir}/build/windows"
    },
