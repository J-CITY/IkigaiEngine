# Compatibility entry for physics consumers; generation is owned by Codegen.cmake.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Codegen.cmake")
function(ikigai_add_physics_reflection)
    ikigai_add_reflection()
    if(NOT TARGET ikigai_physics_reflection)
        add_custom_target(ikigai_physics_reflection)
        add_dependencies(ikigai_physics_reflection ikigai_reflection)
    endif()
endfunction()
