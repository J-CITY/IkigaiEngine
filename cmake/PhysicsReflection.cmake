include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Python.cmake")
get_filename_component(IKIGAI_PHYSICS_REFLECTION_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
function(ikigai_add_physics_reflection)
    if(TARGET ikigai_physics_reflection)
        return()
    endif()
    set(root "${IKIGAI_PHYSICS_REFLECTION_ROOT}")
    set(outputs)
    set(headers)
    foreach(name physics2dComponent forceField2dComponent cloth2dComponent physics3dComponent physicsComponent)
        list(APPEND outputs "${root}/src/engine/generated/${name}.generated.h" "${root}/src/engine/generated/${name}.generated.cpp")
        list(APPEND headers "${root}/src/engine/coreModule/ecs/components/${name}.h")
    endforeach()
    add_custom_command(OUTPUT ${outputs}
        COMMAND "${Python3_EXECUTABLE}" "${root}/utils/build/IkigaiHeaderTool.py" "${root}/src" "${root}/src/engine/generated"
        DEPENDS ${headers} "${root}/utils/build/IkigaiHeaderTool.py" VERBATIM)
    add_custom_target(ikigai_physics_reflection DEPENDS ${outputs})
endfunction()
