# Removes explicitly named source files while preserving all unrelated entries.
include_guard(GLOBAL)
get_filename_component(IKIGAI_SELECTION_ROOT "${CMAKE_CURRENT_LIST_DIR}/../src" ABSOLUTE)
function(ikigai_exclude_sources list_name)
    set(excluded)
    foreach(path IN LISTS ARGN)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${IKIGAI_SELECTION_ROOT}")
        cmake_path(NORMAL_PATH path)
        list(APPEND excluded "${path}")
    endforeach()
    set(selected)
    foreach(path IN LISTS ${list_name})
        get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        cmake_path(NORMAL_PATH absolute)
        if(NOT absolute IN_LIST excluded)
            list(APPEND selected "${path}")
        endif()
    endforeach()
    set(${list_name} "${selected}" PARENT_SCOPE)
endfunction()
