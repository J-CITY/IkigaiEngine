include_guard(GLOBAL)
option(USE_NETWORK "Enable network transports and content downloads" ON)
option(IKIGAI_NETWORK_TLS "Enable native HTTPS/WSS with OpenSSL" ON)
function(ikigai_configure_network target)
    set(_IKIGAI_NETWORK_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(NOT USE_NETWORK)
        return()
    endif()
    if(EMSCRIPTEN)
        target_compile_definitions(${target} PRIVATE IKIGAI_NETWORK_WEB)
        target_link_options(${target} PRIVATE "SHELL:--js-library ${_IKIGAI_NETWORK_ROOT}/emscripten/network.js")
        return()
    endif()
    if(NOT TARGET ikigai_boost_headers)
        # Header-only subset: no stackful coroutine/context dependency is needed.
        add_library(ikigai_boost_headers INTERFACE)
        set(boost_modules asio beast align assert bind config container container_hash core describe
            endian integer intrusive io logic move mp11 optional predef preprocessor smart_ptr
            static_assert static_string system throw_exception tuple type_index type_traits utility winapi)
        foreach(module IN LISTS boost_modules)
            set(headers "${_IKIGAI_NETWORK_ROOT}/3rd/boost/${module}/include")
            if(NOT IS_DIRECTORY "${headers}")
                message(FATAL_ERROR "Missing Boost submodule: 3rd/boost/${module}. Initialize the Boost submodules or set USE_NETWORK=OFF.")
            endif()
            target_include_directories(ikigai_boost_headers SYSTEM INTERFACE "${headers}")
        endforeach()
        target_compile_definitions(ikigai_boost_headers INTERFACE BOOST_ASIO_NO_DEPRECATED)
    endif()
    find_package(Threads REQUIRED)
    target_compile_definitions(${target} PRIVATE IKIGAI_NETWORK_ASIO)
    target_link_libraries(${target} PRIVATE ikigai_boost_headers Threads::Threads)
    if(IKIGAI_NETWORK_TLS)
        # Reuse the locally prepared Windows dependencies in fresh build trees.
        # Explicit CMake/environment roots keep precedence over this hint.
        if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT OPENSSL_ROOT_DIR AND NOT DEFINED ENV{OPENSSL_ROOT_DIR})
            set(local_openssl "${_IKIGAI_NETWORK_ROOT}/utils/.pack/vcpkg/installed/x64-windows-static-md")
            if(EXISTS "${local_openssl}/include/openssl/ssl.h"
                AND EXISTS "${local_openssl}/lib/libssl.lib"
                AND EXISTS "${local_openssl}/lib/libcrypto.lib")
                set(OPENSSL_ROOT_DIR "${local_openssl}" CACHE PATH "OpenSSL installation root")
                if(NOT DEFINED OPENSSL_USE_STATIC_LIBS)
                    set(OPENSSL_USE_STATIC_LIBS ON CACHE BOOL "Use static OpenSSL libraries")
                endif()
            endif()
        endif()
        find_package(OpenSSL REQUIRED)
        target_compile_definitions(${target} PRIVATE IKIGAI_NETWORK_TLS)
        target_link_libraries(${target} PRIVATE OpenSSL::SSL OpenSSL::Crypto)
    endif()
    if(WIN32)
        # Streamline, DX12, and Tracy on GNU/Clang use Windows 10 declarations.
        if(USE_STREAMLINE OR USE_DX12 OR (IKIGAI_ENABLE_TRACY AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang"))
            set(network_windows_version 0x0A00)
        else()
            set(network_windows_version 0x0601)
        endif()
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _WIN32_WINNT=${network_windows_version})
        target_link_libraries(${target} PRIVATE ws2_32 mswsock crypt32)
    endif()
endfunction()
