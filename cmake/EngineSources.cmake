# Selects engine files exclusively from checked-in manifests, never filesystem globs.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/SourceSelection.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EngineModules.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Math.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Memory.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Coroutines.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Time.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Services.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Logging.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VirtualGeometry.cmake")

function(ikigai_collect_engine_sources root headers_out sources_out)
    set(owned_files)
    foreach(module ikigai_math ikigai_memory ikigai_coroutines ikigai_time ikigai_services ikigai_logging
        ikigai_vmesh_format ikigai_virtual_geometry)
        get_target_property(files ${module} SOURCES)
        list(APPEND owned_files ${files})
    endforeach()
    set(extensions .c .cpp .cxx)
    if("OBJC" IN_LIST ARGN)
        list(APPEND extensions .m .mm)
    endif()
    set(headers)
    set(sources)
    foreach(module IN LISTS IKIGAI_MODULE_MANIFEST_NAMES)
        foreach(file IN LISTS IKIGAI_MANIFEST_${module})
            if(file IN_LIST owned_files)
                continue()
            endif()
            get_filename_component(extension "${file}" LAST_EXT)
            if(extension STREQUAL ".h" OR extension STREQUAL ".hpp")
                list(APPEND headers "${file}")
            elseif(extension IN_LIST extensions)
                list(APPEND sources "${file}")
            endif()
        endforeach()
    endforeach()
    set(${headers_out} "${headers}" PARENT_SCOPE)
    set(${sources_out} "${sources}" PARENT_SCOPE)
endfunction()
