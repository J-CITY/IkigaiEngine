include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Tracy.cmake")
get_filename_component(IKIGAI_APPLICATION_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET ArgParse::ArgParse)
    add_subdirectory("${IKIGAI_APPLICATION_ROOT}/3rd/ArgParse" "${CMAKE_CURRENT_BINARY_DIR}/3rd/ArgParse")
endif()

option(IKIGAI_BUILD_TEST_MODULE "Build local test runner instead of the application entry point" OFF)
function(ikigai_configure_application target)
    target_link_libraries(${target} PRIVATE ArgParse::ArgParse ikigai_trace)
    if(WIN32)
        include("${IKIGAI_APPLICATION_ROOT}/cmake/CrashReporting.cmake")
        ikigai_configure_crash_reporting(${target})
    endif()
    if(IKIGAI_BUILD_TEST_MODULE)
        if(NOT EXISTS "${IKIGAI_APPLICATION_ROOT}/testModule/CMakeLists.txt")
            message(FATAL_ERROR "IKIGAI_BUILD_TEST_MODULE requires the optional local testModule checkout")
        endif()
        include("${IKIGAI_APPLICATION_ROOT}/testModule/CMakeLists.txt")
        ikigai_attach_test_module(${target})
    endif()
endfunction()
