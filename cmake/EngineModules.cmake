# Builds the remaining coupled engine modules as object libraries. Objects retain
# the application's link semantics (including registrations) without archive cycles.
# Independent libraries keep their existing targets; generated reflection and entry
# points stay on the application. Splitting C++ API dependencies is a separate step.
include_guard(GLOBAL)
get_filename_component(IKIGAI_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../src" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/ModuleManifests.cmake")
set(IKIGAI_IMPLEMENTATION_EXTENSIONS .c .cpp .cxx .m .mm)

function(ikigai_add_engine_modules application)
    # Snapshot the final platform/feature requirements once. Do not link back to the
    # executable: that would create a cycle and lose private compile requirements.
    set(configuration "${application}_module_configuration")
    add_library(${configuration} INTERFACE)
    foreach(property INCLUDE_DIRECTORIES SYSTEM_INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES)
        get_target_property(value ${application} ${property})
        if(value)
            set_property(TARGET ${configuration} PROPERTY INTERFACE_${property} "${value}")
        endif()
    endforeach()
    get_target_property(libraries ${application} LINK_LIBRARIES)
    if(libraries)
        target_link_libraries(${configuration} INTERFACE ${libraries})
    endif()
    get_target_property(dependencies ${application} MANUALLY_ADDED_DEPENDENCIES)
    get_target_property(remaining ${application} SOURCES)
    foreach(module IN LISTS IKIGAI_MODULE_MANIFEST_NAMES)
        if(module STREQUAL "application")
            continue()
        endif()
        set(selected)
        set(has_implementation FALSE)
        foreach(source IN LISTS IKIGAI_MANIFEST_${module})
            if(source IN_LIST remaining)
                list(APPEND selected "${source}")
                get_filename_component(extension "${source}" LAST_EXT)
                if(extension IN_LIST IKIGAI_IMPLEMENTATION_EXTENSIONS)
                    set(has_implementation TRUE)
                endif()
            endif()
        endforeach()
        if(NOT selected)
            continue()
        endif()
        set(owner "ikigai_module_${module}")
        if(has_implementation)
            add_library(${owner} OBJECT ${selected})
            target_link_libraries(${owner} PRIVATE ${configuration})
            target_compile_features(${owner} PRIVATE cxx_std_20)
            set_target_properties(${owner} PROPERTIES POSITION_INDEPENDENT_CODE ON)
            foreach(property CXX_STANDARD CXX_STANDARD_REQUIRED CXX_EXTENSIONS C_STANDARD C_STANDARD_REQUIRED C_EXTENSIONS OBJC_STANDARD OBJC_STANDARD_REQUIRED OBJC_EXTENSIONS OBJCXX_STANDARD OBJCXX_STANDARD_REQUIRED OBJCXX_EXTENSIONS MSVC_RUNTIME_LIBRARY OSX_ARCHITECTURES)
                get_target_property(value ${application} ${property})
                if(NOT "${value}" MATCHES "-NOTFOUND$")
                    set_property(TARGET ${owner} PROPERTY ${property} "${value}")
                endif()
            endforeach()
            if(dependencies)
                add_dependencies(${owner} ${dependencies})
            endif()
            target_sources(${application} PRIVATE $<TARGET_OBJECTS:${owner}>)
        else()
            # Header-only groups still have an explicit owner visible in IDEs.
            add_library(${owner} INTERFACE)
            target_sources(${owner} PRIVATE ${selected})
        endif()
        set_property(TARGET ${owner} PROPERTY FOLDER "Engine modules")
        list(REMOVE_ITEM remaining ${selected})
    endforeach()
    # Keep the object expressions added above together with entry/generated sources.
    get_target_property(with_objects ${application} SOURCES)
    foreach(source IN LISTS with_objects)
        if(source MATCHES "^\\$<TARGET_OBJECTS:")
            list(APPEND remaining "${source}")
        endif()
    endforeach()
    set_property(TARGET ${application} PROPERTY SOURCES "${remaining}")
endfunction()
