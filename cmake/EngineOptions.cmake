# Declares shared engine feature defaults and validates platform capabilities.
# The launcher resolves these same options in script mode before installing SDKs.
include_guard(GLOBAL)

option(USE_LUA "Enable Lua scripting" ON)
option(USE_IKIGAI_SCRIPT "Enable IkigaiScript scripting" ON)
option(USE_AI "Enable behavior trees, blackboards and navigation queries" ON)
option(USE_CAPTURE "Enable screenshot capture" ON)
option(USE_PROFILER "Enable the CPU and GPU profiler module" ON)
option(USE_NETWORK "Enable network transports and content downloads" ON)
option(IKIGAI_NETWORK_TLS "Enable native HTTPS/WSS with OpenSSL" ON)
option(USE_DLSS "Enable NVIDIA DLSS Super Resolution (Windows Vulkan/DX12)" OFF)
option(USE_FSR "Enable AMD FSR Upscaling (Windows Vulkan/DX12)" OFF)
option(USE_FSR_FRAME_GENERATION "Enable AMD FSR Frame Generation (Windows Vulkan/DX12)" OFF)
option(USE_DLSS_FRAME_GENERATION "Enable NVIDIA DLSS Frame Generation (Windows Vulkan/DX12)" OFF)
option(USE_STREAMLINE "Use Streamline for NVIDIA SR/FG and Reflex" ${USE_DLSS_FRAME_GENERATION})

macro(ikigai_configure_engine_options target_platform)
    set(IKIGAI_OPTIONS_PLATFORM "${target_platform}")
    if(IKIGAI_OPTIONS_PLATFORM STREQUAL "windows")
        set(IKIGAI_OPTIONS_PLATFORM win)
    elseif(IKIGAI_OPTIONS_PLATFORM STREQUAL "emscripten")
        set(IKIGAI_OPTIONS_PLATFORM web)
    endif()
    if(NOT IKIGAI_OPTIONS_PLATFORM MATCHES "^(win|mac|linux|ios|web|android|quest)$")
        message(FATAL_ERROR "Unknown engine platform: ${target_platform}")
    endif()

    set(_ikigai_editor_default ON)
    set(_ikigai_watcher_default ON)
    if(IKIGAI_OPTIONS_PLATFORM MATCHES "^(ios|web|android|quest)$")
        set(_ikigai_watcher_default OFF)
    endif()
    if(IKIGAI_OPTIONS_PLATFORM STREQUAL "quest")
        set(_ikigai_editor_default OFF)
    endif()
    option(USE_SDL "Use SDL window backend" ON)
    option(USE_MIMALLOC "Use mimalloc override" OFF)
    option(USE_EDITOR "Build with in-engine editor UI" ${_ikigai_editor_default})
    option(USE_FILE_WATCHER "Watch asset files for hot reload" ${_ikigai_watcher_default})
    # Preserve the requested cache value, but disable its use without the editor.
    if(NOT USE_EDITOR)
        set(USE_FILE_WATCHER OFF)
    endif()
    option(USE_OPENGL "Use OpenGL rendering backend" ON)
    option(USE_VULKAN "Use Vulkan rendering backend" OFF)
    option(USE_DX12 "Use DX12 rendering backend" OFF)
    option(USE_METAL "Use Metal rendering backend" OFF)

    set(_ikigai_allowed_backends OPENGL)
    if(IKIGAI_OPTIONS_PLATFORM MATCHES "^(win|mac|linux)$")
        list(APPEND _ikigai_allowed_backends VULKAN)
    endif()
    if(IKIGAI_OPTIONS_PLATFORM STREQUAL "win")
        list(APPEND _ikigai_allowed_backends DX12)
    elseif(IKIGAI_OPTIONS_PLATFORM MATCHES "^(mac|ios)$")
        list(APPEND _ikigai_allowed_backends METAL)
    endif()

    if(NOT DEFINED IKIGAI_BUILD_APPLICATION OR IKIGAI_BUILD_APPLICATION)
        set(_ikigai_any_backend OFF)
        foreach(_ikigai_backend OPENGL VULKAN DX12 METAL)
            if(USE_${_ikigai_backend})
                set(_ikigai_any_backend ON)
                if(NOT _ikigai_backend IN_LIST _ikigai_allowed_backends)
                    message(FATAL_ERROR "USE_${_ikigai_backend} is not supported on ${IKIGAI_OPTIONS_PLATFORM}")
                endif()
            endif()
        endforeach()
        if(NOT _ikigai_any_backend)
            message(FATAL_ERROR "At least one rendering backend must be enabled")
        endif()
        if(IKIGAI_OPTIONS_PLATFORM STREQUAL "quest" AND (USE_EDITOR OR USE_FILE_WATCHER))
            message(FATAL_ERROR "Quest does not support USE_EDITOR or USE_FILE_WATCHER")
        endif()
        if(USE_DLSS_FRAME_GENERATION AND NOT USE_STREAMLINE)
            message(FATAL_ERROR "DLSS Frame Generation requires USE_STREAMLINE")
        endif()
        if((USE_DLSS OR USE_FSR OR USE_FSR_FRAME_GENERATION OR USE_STREAMLINE) AND
                (NOT IKIGAI_OPTIONS_PLATFORM STREQUAL "win" OR (NOT USE_VULKAN AND NOT USE_DX12)))
            message(FATAL_ERROR "DLSS/FSR integration currently requires Windows and Vulkan or DX12")
        endif()
    endif()
endmacro()
