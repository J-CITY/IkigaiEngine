include_guard(GLOBAL)

# These independent libraries own their translation units on every platform.
# Remove exact owned files before distributing the remaining coupled modules.
include("${CMAKE_CURRENT_LIST_DIR}/Task.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RenderCommands.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Math.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Memory.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Coroutines.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Time.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Services.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Logging.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VMeshFormat.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EngineModules.cmake")

function(ikigai_link_engine_core target)
    set(core_sources "")
    foreach(core_target ikigai_task ikigai_render_commands ikigai_math ikigai_memory ikigai_coroutines ikigai_time ikigai_services ikigai_logging ikigai_vmesh_format)
        get_target_property(module_sources ${core_target} SOURCES)
        get_target_property(module_source_directory ${core_target} SOURCE_DIR)
        foreach(source IN LISTS module_sources)
            get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${module_source_directory}")
            cmake_path(NORMAL_PATH source_path)
            list(APPEND core_sources "${source_path}")
        endforeach()
    endforeach()

    get_target_property(target_sources ${target} SOURCES)
    get_target_property(target_source_directory ${target} SOURCE_DIR)
    set(application_sources "")
    foreach(source IN LISTS target_sources)
        # A generator expression is evaluated later by CMake, not a filesystem
        # path. Explicit manifests use plain paths; preserve other entries as-is.
        if(source MATCHES "\\$<")
            list(APPEND application_sources "${source}")
            continue()
        endif()
        get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${target_source_directory}")
        cmake_path(NORMAL_PATH source_path)
        if(NOT source_path IN_LIST core_sources)
            list(APPEND application_sources "${source}")
        endif()
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${application_sources}")
    target_link_libraries(${target} PRIVATE ikigai_task ikigai_render_commands ikigai_math ikigai_memory ikigai_coroutines ikigai_time ikigai_services ikigai_logging ikigai_vmesh_format)
    ikigai_add_engine_modules(${target})
endfunction()
