#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
// Screen probe chain after the screen trace (hybrid-sp-rt, M3-4): one invocation per radiance atlas cell. Reads the screen
// trace atlas (ScreenRadiance = SPRadiance) and writes the same atlas layout to Radiance (SPRadianceRT, which the later stages
// read; without ray queries the stage is bypassed and SPRadianceRT aliases SPRadiance, i.e. hybrid-sp behaviour).
// Cells that SPTrace marked as misses (SP_KIND_MISS) continue screen -> ray query -> DDGI -> environment:
//   RAY_QUERY: ray query against the TLAS from the probe position (G-buffer, as SPTrace) along the same cell direction, up
//     to RayQueryMaxDistance. Hit: emissive + direct light with ray query shadows (rtLighting.glsl, as hybrid.rgen shadeHit)
//     + secondary light albedo * DDGI irradiance (probeIrradiance of ddgiSample.glsl, as ddgi.rgen) when DDGI is enabled.
//     No hit: radiance beyond the range from the DDGI volume at the ray end (normal = ray direction, i.e. the cosine-weighted
//     incoming radiance around the ray), the remaining confidence from the environment.
//   Without RAY_QUERY: DDGI at the probe position along the ray direction, the rest from the environment.
// Screen hits and invalid probes are copied. Output alpha is the SP_KIND_* of the source (screenProbeMath.glsl).
#include "../../raytracing/frame.glsl"
#include "../../raytracing/ddgiSample.glsl"
#include "screenProbeSettings.glsl"
#include "screenProbeMath.glsl"
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=1,binding=0) uniform accelerationStructureEXT SceneAS;
struct Triangle {vec4 P0,P1,P2,N0,N1,N2,Albedo,Properties,UV01,UV2;};
layout(std430,set=1,binding=1) readonly buffer Triangles {Triangle triangles[];} RTGeometry;
layout(std430,set=1,binding=2) readonly buffer Instances {uvec4 offsets[];} RTInstances;
layout(set=1,binding=3) uniform sampler2D RTAlbedoMaps[64];
layout(set=2,binding=0,rgba16f) uniform writeonly image2D Radiance;
layout(set=2,binding=7) uniform sampler2D ScreenRadiance;
layout(set=2,binding=1) uniform sampler2D Depth;
layout(set=2,binding=2) uniform sampler2D Normals;
layout(set=2,binding=3) uniform sampler2D ProbeInfo;
layout(set=2,binding=4) uniform samplerCube Environment;
layout(set=2,binding=5) uniform sampler2D DdgiIrradiance;
layout(set=2,binding=6) uniform sampler2D DdgiDistance;
#include "../../raytracing/rtLighting.glsl"

const float SP_RAY_BIAS=0.005;

// Alpha test of a candidate triangle (same rule as visibility.comp and alpha.rahit).
bool spOpaque(uint instance,uint primitive,vec2 hitBary) {
    Triangle t=RTGeometry.triangles[RTInstances.offsets[instance].x+primitive];
    vec3 b=vec3(1-hitBary.x-hitBary.y,hitBary);
    vec2 uv=t.UV01.xy*b.x+t.UV01.zw*b.y+t.UV2.xy*b.z;
    return t.Albedo.a*textureLod(RTAlbedoMaps[nonuniformEXT(instance)],uv,0).a>=.5;
}

float rtLightVisibility(vec3 p,vec3 n,vec3 l,float distance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query,SceneAS,gl_RayFlagsTerminateOnFirstHitEXT,255,p+n*SP_RAY_BIAS,.001,l,max(distance,.002));
    while(rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)!=gl_RayQueryCandidateIntersectionTriangleEXT)continue;
        if(spOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(query,false),rayQueryGetIntersectionPrimitiveIndexEXT(query,false),
               rayQueryGetIntersectionBarycentricsEXT(query,false))) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    return rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionNoneEXT?1:0;
}

// DDGI irradiance / pi (the unit of the probe atlas) at p for normal n, scaled by its confidence; 0 without a volume.
vec3 spDdgi(vec3 p,vec3 n,out float confidence) {
    confidence=0.0;
    if(!spChainEnabled(SP_CHAIN_DDGI)||ScreenProbe.Chain.y==0)return vec3(0.0);
    vec3 irradiance=probeIrradiance(p,n,ScreenProbe.DdgiOriginSpacing,ScreenProbe.DdgiCounts.xyz,DdgiIrradiance,DdgiDistance,confidence);
    return max(irradiance,vec3(0.0))*max(ScreenProbe.RayQuery.z,0.0);
}

vec3 spEnvironment(vec3 dir) {
    return spChainEnabled(SP_CHAIN_ENVIRONMENT)?max(textureLod(Environment,dir,0).rgb,vec3(0.0)):vec3(0.0);
}

// Closest alpha-tested hit; returns false on a miss within maxDistance.
bool spTraceClosest(vec3 origin,vec3 dir,float maxDistance,out vec3 radiance) {
    radiance=vec3(0.0);
    rayQueryEXT query;
    rayQueryInitializeEXT(query,SceneAS,gl_RayFlagsNoneEXT,255,origin,.001,dir,maxDistance);
    while(rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)!=gl_RayQueryCandidateIntersectionTriangleEXT)continue;
        if(spOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(query,false),rayQueryGetIntersectionPrimitiveIndexEXT(query,false),
               rayQueryGetIntersectionBarycentricsEXT(query,false))) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    if(rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionTriangleEXT)return false;
    uint instance=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true);
    uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(query,true);
    vec2 hitBary=rayQueryGetIntersectionBarycentricsEXT(query,true);
    float distance=rayQueryGetIntersectionTEXT(query,true);
    // Surface reconstruction as surface.rchit.
    Triangle t=RTGeometry.triangles[RTInstances.offsets[instance].x+primitive];
    vec3 b=vec3(1-hitBary.x-hitBary.y,hitBary);
    vec3 n=t.N0.xyz*b.x+t.N1.xyz*b.y+t.N2.xyz*b.z;
    if(dot(n,n)<1e-10)n=cross(t.P1.xyz-t.P0.xyz,t.P2.xyz-t.P0.xyz);
    n=normalize(n);
    if(dot(n,dir)>0)n=-n;
    vec3 p=origin+distance*dir;
    vec2 uv=t.UV01.xy*b.x+t.UV01.zw*b.y+t.UV2.xy*b.z;
    vec3 albedo=pow(max(t.Albedo.rgb*textureLod(RTAlbedoMaps[nonuniformEXT(instance)],uv,0).rgb,vec3(0)),vec3(2.2));
    float roughness=clamp(t.Properties.x,.04,1);
    float metallic=clamp(t.Properties.y,0,1);
    vec3 emissive=max(vec3(t.Properties.zw,t.UV2.z),vec3(0));
    radiance=rtAccumulateDirectLight(emissive,p,n,-dir,albedo,roughness,metallic);
    float confidence;
    vec3 irradiance=spDdgi(p,n,confidence);
    radiance+=confidence*albedo*(1-metallic)*irradiance;
    return true;
}

void main() {
    ivec2 texel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(texel,imageSize(Radiance))))return;
    // The screen atlas can be a 1x1 bypass alias when the screen stages are unsupported: out of range reads as invalid.
    vec4 current=all(lessThan(texel,textureSize(ScreenRadiance,0)))?texelFetch(ScreenRadiance,texel,0):vec4(0.0);
    bool rayQuery=spChainEnabled(SP_CHAIN_RAY_QUERY);
    bool ddgi=spChainEnabled(SP_CHAIN_DDGI)&&ScreenProbe.Chain.y!=0;
    int side=spDirectionSide();
    ivec2 probe=texel/side;
    ivec2 cell=texel-probe*side;
    ivec2 pixel;
    if(spSampleSource(current.a)!=SP_SOURCE_ENVIRONMENT||(!rayQuery&&!ddgi)||any(greaterThanEqual(probe,textureSize(ProbeInfo,0)))
        ||!spProbePixel(ProbeInfo,probe,pixel)) {
        imageStore(Radiance,texel,current);
        return;
    }
    vec2 size=vec2(textureSize(Depth,0));
    vec2 uv=(vec2(pixel)+0.5)/size;
    vec3 position=worldPosition(uv,texelFetch(Depth,pixel,0).r);
    vec3 normal=normalize(texelFetch(Normals,pixel,0).xyz);
    vec3 dir=spProbeDirection(probe,cell,normal,uint(engine_UBO.FrameCount));
    float viewDepth=-(engine_UBO.View*vec4(position,1.0)).z;
    vec3 origin=position+normal*max(0.002,0.001*viewDepth);
    vec3 farPoint=origin;
    if(rayQuery) {
        float maxDistance=max(ScreenProbe.RayQuery.x,0.01);
        vec3 radiance;
        if(spTraceClosest(origin,dir,maxDistance,radiance)) {
            imageStore(Radiance,texel,vec4(max(radiance,vec3(0.0)),SP_KIND_RAY_QUERY));
            return;
        }
        farPoint=origin+dir*maxDistance;
    }
    float confidence;
    vec3 cached=spDdgi(farPoint,dir,confidence);
    vec3 radiance=confidence*cached+(1.0-confidence)*spEnvironment(dir);
    float kind=confidence>0.0?(rayQuery?SP_KIND_DDGI_AFTER_RAY:SP_KIND_DDGI):(rayQuery?SP_KIND_MISS_AFTER_RAY:SP_KIND_MISS);
    imageStore(Radiance,texel,vec4(max(radiance,vec3(0.0)),kind));
}
