#version 460
#extension GL_EXT_ray_tracing : require
struct Data { vec4 Color; uint Step; };
layout(location=0) rayPayloadInEXT Data data;
hitAttributeEXT vec2 attributes;
void terminate() { data.Step=123;terminateRayEXT; }
bool nestedAccept() { terminate();data.Step=999;return true; }
float nestedIgnore() { data.Step=77;ignoreIntersectionEXT;return 0; }
void main() {
    uint mode=gl_LaunchIDEXT.x%3;
    if(mode==1) { bool unreachable=nestedAccept();data.Step=999; }
    if(mode==2) { float unreachable=nestedIgnore();data.Step=999; }
}
