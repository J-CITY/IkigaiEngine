#version 460
#extension GL_EXT_ray_tracing : require
struct Data { vec4 Color; uint Step; };
layout(location=0) rayPayloadEXT Data data;
layout(set=0,binding=0) uniform accelerationStructureEXT Scene;
layout(set=0,binding=1,rgba32f) uniform image2D Output;
void main() {
    uint mode=gl_LaunchIDEXT.x%3;
    data.Color=vec4(0);data.Step=37+mode;
    uint before=data.Step;
    traceRayEXT(Scene,0,255,0,1,0,vec3(2.0+float(gl_LaunchIDEXT.x%3)*.05,0,2),0.001,vec3(0,0,-1),100,0);
    if(before!=37+mode || data.Step!=(mode==0 ? 37u : mode==1 ? 123u : 77u))data.Color=vec4(1,0,0,1);
    imageStore(Output,ivec2(gl_LaunchIDEXT.xy),data.Color);
}
