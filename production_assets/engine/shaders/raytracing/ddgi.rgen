#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "surface.glsl"
#include "ddgiSample.glsl"
layout(location=0) rayPayloadEXT SurfacePayload hit;
layout(location=1) rayPayloadEXT float visibility;
layout(set=1,binding=0) uniform accelerationStructureEXT SceneAS;
layout(set=2,binding=0,rgba32f) uniform image2D RayRadiance;
layout(set=2,binding=1,rgba32f) uniform image2D RayDirectionDistance;
layout(set=3,binding=0) uniform samplerCube Environment;
layout(set=3,binding=1) uniform sampler2D PreviousIrradiance;
layout(set=3,binding=2) uniform sampler2D PreviousDistance;
struct Light {vec3 pos;float cutoff;vec3 forward;float outerCutoff;vec3 color;float constant;int type;float linear;float quadratic;float intensity;float radius;int shadows;float nearPlane,farPlane;};
layout(std430,set=0,binding=3) readonly buffer Lights {Light lights[];} engine_Lights;
layout(push_constant) uniform Grid {vec4 OriginSpacing;ivec4 CountsRays;vec4 Options;} grid;
void main() {
    ivec2 coord=ivec2(gl_LaunchIDEXT.xy);int probe=coord.y;
    ivec3 index=ivec3(probe%grid.CountsRays.x,(probe/grid.CountsRays.x)%grid.CountsRays.y,probe/(grid.CountsRays.x*grid.CountsRays.y));
    vec3 origin=grid.OriginSpacing.xyz+vec3(index)*grid.OriginSpacing.w;
    rngState=uint(probe)*9161u+uint(engine_RayFrame.State.z)*7919u+17u;
    float rotation=randomFloat()*6.2831853,z=1-2*(float(coord.x)+.5)/float(grid.CountsRays.w);
    float angle=float(coord.x)*2.39996323+rotation;vec3 direction=vec3(sqrt(1-z*z)*cos(angle),z,sqrt(1-z*z)*sin(angle));
    hit.T=-1;traceRayEXT(SceneAS,gl_RayFlagsNoneEXT,255,0,0,0,origin,.001,direction,grid.Options.y,0);
    vec3 color=vec3(0);float distance=grid.Options.y;
    if(hit.T<0)color=textureLod(Environment,direction,0).rgb;
    else {
        vec3 p=hit.P,n=hit.N,albedo=hit.Albedo;distance=hit.T;
        color+=hit.Emissive;
        for(int i=0;i<engine_Lights.lights.length();++i) {
            Light light=engine_Lights.lights[i];if(light.type<0||light.type>2||light.intensity<=0)continue;
            vec3 delta=light.pos-p;float d=max(length(delta),.001);vec3 l=light.type==1?normalize(-light.forward):delta/d;
            float attenuation=light.type==1?1:1/max(light.constant+light.linear*d+light.quadratic*d*d,.001);
            if(light.type==2){float outer=cos(radians(light.outerCutoff)),inner=cos(radians(light.cutoff));attenuation*=clamp((dot(-l,normalize(light.forward))-outer)/max(inner-outer,.0001),0,1);}
            visibility=1;
            if(light.shadows!=0){visibility=0;traceRayEXT(SceneAS,gl_RayFlagsTerminateOnFirstHitEXT|gl_RayFlagsSkipClosestHitShaderEXT,255,0,0,1,p+n*grid.Options.z,.001,l,light.type==1?grid.Options.y:max(d-.002,.002),1);}
            color+=albedo*(1-hit.Metallic)/3.14159265*light.color*light.intensity*attenuation*max(dot(n,l),0)*visibility;
        }
        if(engine_RayFrame.State.w>.5&&grid.Options.x>0) {
            float confidence;vec3 irradiance=probeIrradiance(p,n,grid.OriginSpacing,grid.CountsRays.xyz,PreviousIrradiance,PreviousDistance,confidence);
            color+=grid.Options.x*confidence*albedo*(1-hit.Metallic)*irradiance;
        }
    }
    imageStore(RayRadiance,coord,vec4(max(color,vec3(0)),1));
    imageStore(RayDirectionDistance,coord,vec4(direction,distance));
}
