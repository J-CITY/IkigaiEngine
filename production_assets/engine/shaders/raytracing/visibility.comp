#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=1,binding=0) uniform accelerationStructureEXT SceneAS;
struct Triangle {vec4 P0,P1,P2,N0,N1,N2,Albedo,Properties,UV01,UV2;};
layout(std430,set=1,binding=1) readonly buffer Triangles {Triangle triangles[];} RTGeometry;
layout(std430,set=1,binding=2) readonly buffer Instances {uvec4 offsets[];} RTInstances;
layout(set=1,binding=3) uniform sampler2D RTAlbedoMaps[64];
layout(set=2,binding=0,rgba32f) uniform image2D Output;
layout(set=2,binding=1) uniform sampler2D Depth;
layout(set=2,binding=2) uniform sampler2D Normals;
struct Light {vec3 pos;float cutoff;vec3 forward;float outerCutoff;vec3 color;float constant;int type;float linear;float quadratic;float intensity;float radius;int shadows;float nearPlane,farPlane;};
layout(std430,set=0,binding=3) readonly buffer Lights {Light lights[];} engine_Lights;
layout(std140,set=0,binding=4) uniform CurrentShadow {mat4 Matrices[4];vec4 CascadeSplits,PositionRange,Settings,LightInfo;} engine_CurrentShadow;
layout(push_constant) uniform Options {uint Mode;uint Samples;float Radius;float Bias;} settings;
float visible(vec3 p,vec3 n,vec3 direction,float distance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query,SceneAS,gl_RayFlagsTerminateOnFirstHitEXT,255,p+n*settings.Bias,.001,direction,max(distance,.002));
    while(rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)!=gl_RayQueryCandidateIntersectionTriangleEXT)continue;
        uint instance=rayQueryGetIntersectionInstanceCustomIndexEXT(query,false);
        uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(query,false);
        vec2 hitBary=rayQueryGetIntersectionBarycentricsEXT(query,false);
        Triangle t=RTGeometry.triangles[RTInstances.offsets[instance].x+primitive];
        vec3 b=vec3(1-hitBary.x-hitBary.y,hitBary);vec2 uv=t.UV01.xy*b.x+t.UV01.zw*b.y+t.UV2.xy*b.z;
        if(t.Albedo.a*textureLod(RTAlbedoMaps[nonuniformEXT(instance)],uv,0).a>=.5)rayQueryConfirmIntersectionEXT(query);
    }
    return rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionNoneEXT?1:0;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(Output);if(any(greaterThanEqual(pixel,size)))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(size);float depth=textureLod(Depth,uv,0).r;
    if(depth>=.999999){imageStore(Output,pixel,vec4(1));return;}
    vec3 p=worldPosition(uv,depth),n=normalize(textureLod(Normals,uv,0).xyz);
    rngState=uint(pixel.x)+uint(pixel.y)*uint(size.x)+uint(engine_RayFrame.State.z)*9781u+17u;
    uint samples=clamp(settings.Samples,1u,32u);float sum=0;
    if(settings.Mode==1u) {
        for(uint s=0u;s<samples;++s)sum+=visible(p,n,cosineDirection(n),settings.Radius);
    } else {
        int i=int(engine_CurrentShadow.LightInfo.x);
        if(i<0||i>=engine_Lights.lights.length()||engine_CurrentShadow.LightInfo.z<.5){imageStore(Output,pixel,vec4(1));return;}
        Light light=engine_Lights.lights[i];
        for(uint s=0u;s<samples;++s) {
            vec3 delta=light.pos-p;float distance=length(delta);vec3 l=light.type==1?normalize(-light.forward):delta/max(distance,.001);
            vec3 t=normalize(cross(abs(l.y)<.99?vec3(0,1,0):vec3(1,0,0),l));
            float r=sqrt(randomFloat()),a=6.2831853*randomFloat();float spread=light.type==1?settings.Radius:settings.Radius/max(distance,.001);
            l=normalize(l+spread*r*(t*cos(a)+cross(l,t)*sin(a)));
            sum+=visible(p,n,l,light.type==1?10000:distance-.002);
        }
    }
    imageStore(Output,pixel,vec4(vec3(sum/float(samples)),1));
}
