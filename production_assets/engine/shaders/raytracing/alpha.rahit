#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
hitAttributeEXT vec2 bary;
struct Triangle {vec4 P0,P1,P2,N0,N1,N2,Albedo,Properties,UV01,UV2;};
layout(std430,set=1,binding=1) readonly buffer Triangles {Triangle triangles[];} RTGeometry;
layout(std430,set=1,binding=2) readonly buffer Instances {uvec4 offsets[];} RTInstances;
layout(set=1,binding=3) uniform sampler2D RTAlbedoMaps[64];
void main() {
    Triangle t=RTGeometry.triangles[RTInstances.offsets[gl_InstanceCustomIndexEXT].x+gl_PrimitiveID];
    vec3 b=vec3(1-bary.x-bary.y,bary);vec2 uv=t.UV01.xy*b.x+t.UV01.zw*b.y+t.UV2.xy*b.z;
    if(t.Albedo.a*textureLod(RTAlbedoMaps[nonuniformEXT(gl_InstanceCustomIndexEXT)],uv,0).a<.5)ignoreIntersectionEXT;
}
