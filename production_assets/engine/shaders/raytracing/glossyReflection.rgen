#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "surface.glsl"
#include "reflectionGgx.glsl"
#include "glossyReflectionRoughness.glsl"

layout(location=0) rayPayloadEXT SurfacePayload hit;
layout(location=1) rayPayloadEXT float visibility;
layout(set=1,binding=0) uniform accelerationStructureEXT SceneAS;
layout(set=2,binding=0,rgba32f) uniform writeonly image2D Output;
layout(set=2,binding=1) uniform sampler2D Depth;
layout(set=2,binding=2) uniform sampler2D Normals;
layout(set=2,binding=3) uniform sampler2D Albedo;
layout(set=2,binding=4) uniform sampler2D Roughness;
layout(set=2,binding=5) uniform sampler2D SsrResolved;
layout(set=2,binding=6) uniform sampler2D EnvironmentSpecular;
layout(push_constant) uniform Options {uint Mode;uint Samples;float Radius;float Bias;} settings;
#include "rtLighting.glsl"

const float SsrSkipConfidence=0.9;

float rtLightVisibility(vec3 p,vec3 n,vec3 l,float distance) {
    visibility=0;
    traceRayEXT(SceneAS,gl_RayFlagsTerminateOnFirstHitEXT|gl_RayFlagsSkipClosestHitShaderEXT,255,
        0,0,1,p+n*settings.Bias,.001,l,max(distance,.002),1);
    return visibility;
}

vec3 traceGlossy(vec3 p,vec3 n,vec3 v,float rough,vec3 f0,vec3 ibl) {
    vec3 reflected=vec3(0);
    uint samples=clamp(settings.Samples,1u,32u);
    uint hitCount=0u;
    for(uint i=0u;i<samples;++i) {
        vec3 direction=reflectedDirection(n,v,rough);
        float nl=dot(n,direction);
        if(nl<=0.0)continue;
        hit.T=-1;
        traceRayEXT(SceneAS,gl_RayFlagsNoneEXT,255,0,0,0,p+n*settings.Bias,.001,direction,10000,0);
        if(hit.T<0.0)continue;
        vec3 radiance=rtAccumulateDirectLight(hit.Emissive,hit.P,hit.N,-direction,hit.Albedo,hit.Roughness,hit.Metallic);
        reflected+=weightReflectionRadiance(radiance,n,v,direction,nl,rough,f0);
        ++hitCount;
    }
    // IBL already includes the receiver BRDF. Fill the share with no geometry
    // using this preintegrated value, with no further Fresnel multiplication.
    return (reflected+float(samples-hitCount)*ibl)/float(samples);
}

void main() {
    ivec2 pixel=ivec2(gl_LaunchIDEXT.xy),size=imageSize(Output);
    if(any(greaterThanEqual(pixel,size)))return;
    vec2 uv=(vec2(pixel)+0.5)/vec2(size);
    float depth=textureLod(Depth,uv,0).r;
    if(depth>=.999999){imageStore(Output,pixel,vec4(0));return;}

    float rough=clamp(textureLod(Roughness,uv,0).r,.04,1);
    vec3 ibl=textureLod(EnvironmentSpecular,uv,0).rgb;
    if(rough>=GlossyMaxTracedRoughness){imageStore(Output,pixel,vec4(ibl,1));return;}

    vec4 ssr=textureLod(SsrResolved,uv,0);
    float confidence=clamp(ssr.a,0,1);
    vec3 fallback=ibl;
    if(confidence<SsrSkipConfidence) {
        vec3 p=worldPosition(uv,depth),n=normalize(textureLod(Normals,uv,0).xyz),v=normalize(engine_UBO.ViewPos-p);
        vec4 material=textureLod(Albedo,uv,0);
        vec3 f0=mix(vec3(.04),material.rgb,material.a);
        rngState=uint(pixel.x)+uint(pixel.y)*uint(size.x)+uint(engine_RayFrame.State.z)*9781u+17u;
        float rayWeight=1.0-smoothstep(0.8,SsrSkipConfidence,confidence);
        fallback=mix(ibl,traceGlossy(p,n,v,rough,f0,ibl),rayWeight);
    }
    float glossyWeight=glossyTraceWeight(rough);
    vec3 reflected=mix(ibl,mix(fallback,ssr.rgb,confidence),glossyWeight);
    imageStore(Output,pixel,vec4(max(reflected,vec3(0)),1));
}
