{
  "ShaderPath": "/shaders/render/portable/vegetation.shader",
  "IsDeferred": true,
  "BackfaceCulling": true,
  "PbrLayers": {
    "Version": 1,
    "AlphaMode": "Opaque",
    "AlphaCutoff": 0.4,
    "Layers": [
      {
        "Color": {
          "X": 1,
          "Y": 1,
          "Z": 1,
          "W": 1
        },
        "Roughness": 0.86,
        "Weight": 1.0,
        "AlbedoMap": "/textures/surface/garden/soil.png",
        "NormalMap": "/textures/surface/garden/soil-normal.png",
        "HeightMap": "/textures/surface/garden/soil-height.png"
      }
    ]
  },
  "Uniforms": {}
}
