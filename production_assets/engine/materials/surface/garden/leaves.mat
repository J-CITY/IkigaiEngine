{
  "ShaderPath": "/shaders/render/portable/vegetation.shader",
  "IsDeferred": true,
  "BackfaceCulling": false,
  "PbrLayers": {
    "Version": 1,
    "AlphaMode": "Masked",
    "AlphaCutoff": 0.4,
    "Layers": [
      {
        "Color": {
          "X": 1,
          "Y": 1,
          "Z": 1,
          "W": 1
        },
        "Roughness": 0.86,
        "Weight": 1.0,
        "AlbedoMap": "/textures/surface/garden/leaf.png",
        "NormalMap": "/textures/surface/garden/leaf-normal.png"
      }
    ]
  },
  "Uniforms": {
    "data_UBOu_Transmission": 0.38
  },
  "Deformation": {
    "Mode": "Foliage",
    "Height": 8,
    "RootHeight": 0,
    "Stiffness": 0.75,
    "WindStrength": 0.18,
    "MaxBend": 0.35,
    "Flutter": 0.015,
    "ProceduralCoverage": false
  }
}
