plugins {
    id 'com.android.application'
}

android {
    namespace = "{{APP_ID}}"
    compileSdk = {{COMPILE_SDK}}

    defaultConfig {
        applicationId "{{APP_ID}}"
        minSdk = {{MIN_SDK}}
        targetSdk = {{TARGET_SDK}}
        versionCode 1
        versionName "1.0"

        externalNativeBuild {
            cmake {
                arguments "-DANDROID_STL=c++_shared", "-DANDROID_PLATFORM={{ANDROID_PLATFORM}}", "-DIKIGAI_GLES_VERSION={{GLES_CMAKE}}"
                abiFilters {{ABI_FILTERS}}
            }
        }

        ndk {
            abiFilters {{ABI_FILTERS}}
        }
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }

    externalNativeBuild {
        cmake {
            path file("{{CMAKE_PATH}}")
        }
    }

    lint {
        abortOnError = false
    }
}
