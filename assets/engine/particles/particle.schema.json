          },
          "then": {
            "required": [
              "Value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "Mode": {
                "const": "uniform"
              }
            }
          },
          "then": {
            "required": [
              "Min",
              "Max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "Mode": {
                "const": "curve"
              }
            }
          },
          "then": {
            "required": [
              "Keys"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "Mode": {
                "const": "curveRange"
              }
            }
          },
          "then": {
            "required": [
              "Min",
              "Max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "Mode": {
                "const": "parameter"
              }
            }
          },
          "then": {
            "required": [
              "Parameter"
            ]
          }
        }
      ]
