            "Bursts": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "properties": {
                  "Time": {
                    "type": "number"
                  },
                  "Count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "Interval": {
                    "type": "number"
                  }
                },
                "required": [
                  "Count"
                ],
                "additionalProperties": false
              }
            },
            "Mode": {
              "enum": [
                "automatic",
                "eventsOnly"
              ]
            }
          },
          "required": [],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "Mode": {
                    "const": "eventsOnly"
                  }
                },
                "required": [
                  "Mode"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "Rate"
                      ]
                    },
                    {
                      "required": [
                        "Bursts"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "Spawn": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/module"
              },
              {
                "properties": {
                  "Type": {
                    "enum": [
                      "Shape",
                      "Initialize",
                      "RadialVelocity",
                      "DirectionalVelocity"
                    ]
                  }
                }
              }
            ]
          }
        },
        "Update": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/module"
              },
              {
                "properties": {
                  "Type": {
                    "enum": [
                      "Acceleration",
                      "Drag",
                      "VelocityOverLife",
                      "IntegrateMotion",
                      "SizeOverLife",
                      "ColorOverLife",
                      "AlphaOverLife",
                      "RotationOverLife",
                      "AngularVelocity",
                      "PositionOffsetOverLife",
                      "PositionOverLife",
                      "Flipbook",
                      "OrientationOverLife",
                      "AngularVelocity3D"
                    ]
                  }
                }
              }
            ]
          }
        },
        "Renderer": {
          "$ref": "#/$defs/renderer"
        },
        "Events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/eventRoute"
          }
        }
      },
      "required": [
        "Id",
        "Spawn",
        "Update",
        "Renderer"
      ],
      "additionalProperties": false
    },
    "eventLimits": {
      "type": "object",
      "properties": {
        "MaxEventsPerStep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
