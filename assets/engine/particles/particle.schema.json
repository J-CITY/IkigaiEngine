          "type": "number"
        },
        "InnerRadius": {
          "type": "number"
        },
        "Height": {
          "type": "number"
        },
        "Lifetime": {
          "$ref": "#/$defs/source"
        },
        "Velocity": {
          "$ref": "#/$defs/source"
        },
        "Color": {
          "$ref": "#/$defs/source"
        },
        "Speed": {
          "$ref": "#/$defs/source"
        },
        "Angle": {
          "$ref": "#/$defs/source"
        },
        "Value": {
          "$ref": "#/$defs/source"
        },
        "Operation": {
          "enum": [
            "multiplyBase",
            "set"
          ]
        },
        "Orientation": {
          "$ref": "#/$defs/source"
        }
