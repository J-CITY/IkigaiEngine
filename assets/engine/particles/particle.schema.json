        "Columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "Rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "Mesh": {
          "type": "string",
          "minLength": 1
        },
        "MeshIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "Type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "Type": {
                "const": "mesh3D"
              }
            }
          },
          "then": {
            "required": [
              "Mesh"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "Alignment"
                  ]
                },
                {
                  "required": [
                    "Pivot"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "Mesh"
                  ]
                },
                {
                  "required": [
                    "MeshIndex"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "emitter": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
