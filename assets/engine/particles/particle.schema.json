        "Texture": {
          "type": "string"
        },
        "Atlas": {
          "type": "string"
        },
        "Piece": {
          "type": "string"
        },
        "Material": {
          "type": "string"
        },
        "Blend": {
          "enum": [
            "alpha",
            "additive",
            "premultiplied"
          ]
        },
        "Alignment": {
          "enum": [
            "camera",
            "velocity",
            "axisLocked"
          ]
        },
        "Layer": {
          "type": "integer"
        },
        "Order": {
          "type": "integer"
        },
        "DepthTest": {
          "type": "boolean"
