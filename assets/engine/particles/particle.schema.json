    "source": {
      "type": "object",
      "properties": {
        "Mode": {
          "enum": [
            "constant",
            "uniform",
            "curve",
            "curveRange",
            "parameter"
          ]
        },
        "Value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "Min": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            {
              "$ref": "#/$defs/curve"
            }
          ]
        },
        "Max": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            {
              "$ref": "#/$defs/curve"
            }
          ]
        },
        "Domain": {
          "enum": [
            "particleNormalizedAge",
            "particleAge",
            "emitterNormalizedAge",
            "emitterAge"
          ]
        },
        "RandomChannels": {
          "enum": [
            "linked",
            "independent"
          ]
        },
        "Parameter": {
          "type": "string"
        },
        "Keys": {
          "type": "array",
