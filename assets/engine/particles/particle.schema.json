    "eventRoute": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "On": {
          "enum": [
            "birth",
            "death"
          ]
        },
        "Emitter": {
          "type": "string",
          "minLength": 1
        },
        "Count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "Probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "InheritVelocity": {
          "type": "number"
        },
        "InheritColor": {
          "type": "boolean"
        }
      },
      "required": [
        "Id",
        "On",
        "Emitter"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "Dimension": {
            "const": "2D"
          }
        }
      },
      "then": {
        "properties": {
          "Emitters": {
            "items": {
              "properties": {
                "Renderer": {
                  "properties": {
                    "Type": {
                      "const": "sprite2D"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "Emitters": {
            "items": {
              "properties": {
                "Renderer": {
                  "properties": {
                    "Type": {
                      "enum": [
                        "billboard3D",
                        "mesh3D"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
